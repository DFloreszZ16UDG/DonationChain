ENVIRONMENT=development
DATABASE_URL=sqlite:///./donationchain.db
AUTO_CREATE_DATABASE=true
JWT_SECRET=replace-with-at-least-32-random-characters
DEMO_PASSWORD=replace-with-a-strong-local-demo-password
ACCESS_TOKEN_MINUTES=480
LOGIN_RATE_LIMIT_ATTEMPTS=8
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
CORS_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
FORCE_HTTPS=false
MAX_RECEIPT_BYTES=10485760
STORAGE_BACKEND=local
RECEIPT_DIRECTORY=./storage/receipts

# For private persistent object storage in production:
S3_BUCKET=
S3_PREFIX=receipts
S3_REGION=
S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are read by the standard AWS SDK.

# Sepolia is an Ethereum Proof-of-Stake test network.
BLOCKCHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BLOCKCHAIN_CHAIN_ID=11155111
BLOCKCHAIN_EXPLORER_URL=https://sepolia.etherscan.io

# Add these only after deploying contracts/DonationTraceability.sol.
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=

