ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://donationchain:replace-password@postgres:5432/donationchain
AUTO_CREATE_DATABASE=false
JWT_SECRET=replace-with-at-least-48-random-characters
ACCESS_TOKEN_MINUTES=60
LOGIN_RATE_LIMIT_ATTEMPTS=8
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
CORS_ORIGINS=https://donationchain.example.com
TRUSTED_HOSTS=localhost,127.0.0.1,donationchain.example.com,api.donationchain.example.com
FORCE_HTTPS=false
MAX_RECEIPT_BYTES=10485760

# Use "local" only with a mounted persistent volume. Prefer "s3" in cloud hosting.
STORAGE_BACKEND=local
RECEIPT_DIRECTORY=/data/receipts
S3_BUCKET=
S3_PREFIX=receipts
S3_REGION=
S3_ENDPOINT_URL=

BLOCKCHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BLOCKCHAIN_CHAIN_ID=11155111
BLOCKCHAIN_EXPLORER_URL=https://sepolia.etherscan.io
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
